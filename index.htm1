<!DOCTYPE html>
<html lang="sw">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>XAUUSD Gold Price</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Segoe UI', sans-serif; }
        body { 
            background: linear-gradient(135deg, #0a0a0f 0%, #1a1a2e 100%);
            color: #fff;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }
        .container {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 215, 0, 0.2);
            border-radius: 30px;
            padding: 50px;
            max-width: 600px;
            width: 100%;
            text-align: center;
        }
        h1 { color: #ffd700; font-size: 2.5em; margin-bottom: 10px; }
        .subtitle { color: #888; margin-bottom: 40px; }
        .price-box {
            background: linear-gradient(135deg, rgba(255, 215, 0, 0.1), transparent);
            border: 2px solid rgba(255, 215, 0, 0.3);
            border-radius: 20px;
            padding: 40px;
            margin-bottom: 30px;
        }
        .price {
            font-size: 5em;
            font-weight: 800;
            color: #ffd700;
            text-shadow: 0 0 30px rgba(255, 215, 0, 0.5);
        }
        .stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-bottom: 30px;
        }
        .stat {
            background: rgba(0, 0, 0, 0.3);
            padding: 20px;
            border-radius: 15px;
        }
        .stat-label { color: #888; font-size: 0.9em; margin-bottom: 8px; }
        .stat-value { color: #ffd700; font-size: 1.5em; font-weight: 700; }
        .update-time { color: #666; font-size: 0.9em; margin-top: 20px; }
        .loading {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 3px solid rgba(255, 215, 0, 0.3);
            border-top-color: #ffd700;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }
        @keyframes spin { to { transform: rotate(360deg); } }
    </style>
</head>
<body>
    <div class="container">
        <h1>🥇 XAUUSD</h1>
        <p class="subtitle">Gold Spot Price - Live Data</p>
        
        <div class="price-box">
            <div class="price" id="price">
                <div class="loading"></div>
            </div>
        </div>
        
        <div class="stats">
            <div class="stat">
                <div class="stat-label">High 24h</div>
                <div class="stat-value" id="high">--</div>
            </div>
            <div class="stat">
                <div class="stat-label">Low 24h</div>
                <div class="stat-value" id="low">--</div>
            </div>
            <div class="stat">
                <div class="stat-label">Change</div>
                <div class="stat-value" id="change" style="color: #10b981;">--</div>
            </div>
        </div>
        
        <p class="update-time" id="time">Updating...</p>
    </div>

    <script>
        async function getGoldPrice() {
            try {
                const response = await fetch('https://api.gold-api.com/price/XAUUSD');
                const data = await response.json();
                
                document.getElementById('price').innerText = '$' + data.price.toFixed(2);
                document.getElementById('high').innerText = '$' + data.high.toFixed(0);
                document.getElementById('low').innerText = '$' + data.low.toFixed(0);
                
                const changeEl = document.getElementById('change');
                const changePercent = data.change_percent;
                changeEl.innerText = (changePercent >= 0 ? '+' : '') + changePercent.toFixed(2) + '%';
                changeEl.style.color = changePercent >= 0 ? '#10b981' : '#ef4444';
                
                document.getElementById('time').innerText = 'Last updated: ' + new Date().toLocaleTimeString();
                
            } catch (error) {
                document.getElementById('price').innerText = 'Error';
                document.getElementById('time').innerText = 'Failed to load data';
            }
        }
        
        // Load immediately
        getGoldPrice();
        
        // Refresh every 30 seconds
        setInterval(getGoldPrice, 30000);
    </script>
</body>
</html>
